SPRING_PROFILES_ACTIVE=prod

LANGCHAIN4J_COMMUNITY_DASHSCOPE_CHAT_MODEL_API_KEY=REPLACE_WITH_DASHSCOPE_KEY
LANGCHAIN4J_COMMUNITY_DASHSCOPE_EMBEDDING_MODEL_API_KEY=REPLACE_WITH_DASHSCOPE_KEY
LANGCHAIN4J_COMMUNITY_DASHSCOPE_STREAMING_CHAT_MODEL_API_KEY=REPLACE_WITH_DASHSCOPE_KEY
BIGMODEL_API_KEY=REPLACE_WITH_BIGMODEL_KEY

# Set a Redis address reachable from the backend process/container.
APP_REDIS_HOST=REPLACE_WITH_REDIS_HOST
APP_REDIS_PORT=6379
APP_REDIS_USER=default
APP_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
APP_REDIS_TTL_SECONDS=604800
# Must match the actual embedding model output dimension.
APP_REDIS_VECTOR_DIMENSION=1024
